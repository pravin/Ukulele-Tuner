# Maintainer: Pravin Paratey <pravinp@gmail.com>
pkgname=uketuner
pkgver=0.2.0
pkgrel=1
pkgdesc="A console utility to tune your ukulele"
arch=('x86_64' 'aarch64')
url="https://github.com/pravin/Ukulele-Tuner"
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'glibc' 'libgcc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ba00d59269a6ff7ab7a2883533762eea871ee6d822d7e73f55c3f39242e3ba93')

prepare() {
  cd "Ukulele-Tuner-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Ukulele-Tuner-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "Ukulele-Tuner-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "Ukulele-Tuner-$pkgver"
  install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
}
